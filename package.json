{
  "name": "@webgrip/renovate-config",
  "version": "0.0.0-semantic-release",
  "description": "Webgrip shared Renovate configuration presets",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "renovate-config-validator --strict default.json grouped.json safe-automerge.json gitops.json golang.json forgejo.json apm.json automerge-non-major.json review-non-major.json security-automerge.json docker-arg-pins.json first-party.json profile-app.json profile-site.json profile-library.json profile-image-set.json",
    "validate:preset": "renovate-config-validator --strict",
    "release": "semantic-release",
    "profiles": "node scripts/profiles.mjs",
    "test": "node --test scripts/profiles.test.mjs"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "renovate": "43.208.0",
    "semantic-release": "^24.2.5"
  }
}
